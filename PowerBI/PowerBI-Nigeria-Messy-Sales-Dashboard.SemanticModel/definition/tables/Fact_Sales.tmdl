table Fact_Sales
	lineageTag: fd0fba33-c700-4965-9a7f-895249dc347d

	measure 'Total Sales' = SUM(Fact_Sales[TotalSale])
		displayFolder: Sales
		lineageTag: 235a0b8a-a7f6-4a87-aac5-99289566a05c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Units' =
			
			SUM(Fact_Sales[UnitsSold])
		formatString: 0
		displayFolder: Transactions
		lineageTag: a48b8488-0edb-482d-87ae-155e211dc225

	measure 'Total Transactions' =
			
			COUNTROWS(Fact_Sales)
		formatString: 0
		displayFolder: Transactions
		lineageTag: b0af3466-287d-40f4-acea-7f4d5bc6b32f

	measure 'Unique Customer' = DISTINCTCOUNT(Fact_Sales[CustomerKey])
		formatString: 0
		displayFolder: Customers
		lineageTag: 48f2c561-5519-48cf-81f3-ff2edb14cbf5

	measure 'Previous Year Sales' = CALCULATE([Total Sales],SAMEPERIODLASTYEAR(DimDate[Date]))
		displayFolder: Time Intelligence
		lineageTag: 205fd38c-307f-4f46-b64e-6194e044f907

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Unit Price' = AVERAGE(Fact_Sales[UnitPrice])
		displayFolder: Sales
		lineageTag: fba34615-279c-4b18-b1dc-08642c953773

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Previous Month Sales' = CALCULATE([Total Sales], DATEADD(DimDate[Date],-1,MONTH))
		displayFolder: Time Intelligence
		lineageTag: 94331f16-f408-4720-af4d-6421ec4a5489

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales YTD' =
			
			TOTALYTD(
			    [Total Sales],
			    DimDate[Date]
			)
		displayFolder: Time Intelligence
		lineageTag: ab31c753-a566-419a-9c96-c125efe1e4a3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'YOY Sales Growth' = DIVIDE([Total Sales]-[Previous Month Sales],[Previous Month Sales])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Time Intelligence
		lineageTag: 7a36c125-f8d6-41ba-b181-936f77d88348

	measure 'MOM sales growth' = DIVIDE(([Total Sales]-[Previous Month Sales]),[Previous Month Sales])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Time Intelligence
		lineageTag: fea33ae5-f19e-4b4d-8438-2a02a953b44a

	measure 'Product Sales Rank' =
			
			RANKX(
			    ALL(DimProduct[Product]),
			    [Total Sales],
			    ,
			    DESC,
			    DENSE
			)
		formatString: 0
		displayFolder: Products
		lineageTag: 24374b0d-ba86-4b9c-940c-8839449c72fd

	measure 'Customer Sales Rank' =
			
			RANKX(
			    ALL(DimCustomer[Customer Name]),
			    [Total Sales],
			    ,
			    DESC,
			    DENSE
			)
		formatString: 0
		displayFolder: Customers
		lineageTag: a0f52024-8f38-414e-b50e-ccbebc4b09e5

	measure 'Missing Units' = CALCULATE(COUNTROWS(Fact_Sales),ISBLANK(Fact_Sales[UnitsSold]))
		formatString: 0
		displayFolder: Data Quality
		lineageTag: 35d3cf4f-8036-4170-8fb9-9bde98777c32

	measure 'Sales MTD' = TOTALMTD([Total Sales],DimDate[Date])
		displayFolder: Time Intelligence
		lineageTag: ef5cb9b9-faf8-4808-bdd0-3757f130423e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales Data Completeness %' =
			
			DIVIDE(
			    COUNTROWS(
			        FILTER(
			            Fact_Sales,
			            NOT ISBLANK(Fact_Sales[TotalSale])
			        )
			    ),
			    COUNTROWS(Fact_Sales)
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Data Quality
		lineageTag: 8b18b7b3-ede5-4c71-bd95-1e82fc51d228

	measure 'Sales Contribution %' =
			
			DIVIDE(
			    [Total Sales],
			    CALCULATE(
			        [Total Sales],
			        ALLSELECTED()
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Products
		lineageTag: b8f2a2df-8a6d-4753-b641-bd01b70ffd36

	measure 'Market Analysis' = "Sales Performance Dashboard- " & COALESCE(SELECTEDVALUE(DimProduct[Product]),"All Products") & " | " & COALESCE(SELECTEDVALUE(DimChannel[Sales Channel]),"All Channels")
		lineageTag: 00c9d680-7302-470c-bea1-eb635d5d0562

	measure 'Channels Details' = "Sales Performance Dashboard- " & COALESCE(SELECTEDVALUE(DimChannel[Sales Channel]),"All Channels")
		lineageTag: 5cbd6fc2-6ebb-44d8-b419-c8a9597756cc

	measure 'Products Details' = "Sales Performance Dashboard- " & COALESCE(SELECTEDVALUE(DimProduct[Product]),"All Products")
		lineageTag: 1b07cec3-3b19-47d7-ab9f-f99d58e7c63a

